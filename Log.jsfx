desc:MIDI Log
// version 04 (v02 DS)
//tags: MIDI analysis utility
// .... pimped by DarkStar, July 2018
// https://forums.cockos.com/showthread.php?t=189126&highlight=midi+logger
//
// casrya: 6/05/2025 added HiDpi scaling and SysEx display (max 8 bytes hex)

in_pin:none
out_pin:none

// ======================================================================
@init
// added by casrya for HiDpi
gfx_ext_retina == 0 ? gfx_ext_retina = 1;

// ======================================================================

// -------------------------------------------------------------
function load_CC_names()
// -------------------------------------------------------------
(
    strcpy(1,"Bank Select MSB");
    strcpy(2,"Mod Wheel MSB");
    strcpy(3,"Breath control MSB");
    strcpy(4," ");
    strcpy(5,"Foot Pedal MSB");
    strcpy(6,"Portamento Time MSB");
    strcpy(7,"Data Entry MSB");
    strcpy(8,"Volume MSB");
    strcpy(9,"Balance MSB");
    strcpy(10," ");
    strcpy(11,"Pan position MSB");
    strcpy(12,"Expression MSB");
    strcpy(13,"Effect Control 1 MSB");
    strcpy(14,"Effect Control 2 MSB");
    strcpy(15," ");
    strcpy(16," ");
    strcpy(17,"GP Slider 1");
    strcpy(18,"GP Slider 2");
    strcpy(19,"GP Slider 3");
    strcpy(20,"GP Slider 4");
    strcpy(21," ");
    strcpy(22," ");
    strcpy(23," ");
