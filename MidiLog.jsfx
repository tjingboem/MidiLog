    strcpy(5,"Foot Pedal MSB");
    strcpy(6,"Portamento Time MSB");
    strcpy(7,"Data Entry MSB");
    strcpy(8,"Volume MSB");
    strcpy(9,"Balance MSB");
    strcpy(10,"Controller");
    strcpy(11,"Pan position MSB");
    strcpy(12,"Expression MSB");
    strcpy(13,"Effect Control 1 MSB");
    strcpy(14,"Effect Control 2 MSB");
    strcpy(15,"Controller");
    strcpy(16,"Controller");
    strcpy(17,"GP Slider 1");
