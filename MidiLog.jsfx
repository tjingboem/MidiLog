); // end of function

ext_midi_bus = 1; // causes midi_bus to be used for send/recv and midirecv() receives on all buses
ext_noinit =1;    // does not initialise on clicking Play
ent_time = 0;
ent_blockoffs = 1;
ent_midiinfo = 2;
// casrya: add extra field so we can store up to 8 SysEx bytes (each jsfx array value is 32 bits)
ent_midiinfo2 = 3;
// casrya: store actual sysex byte count (but only display max 8 as hex bytes)
ent_sysex_cnt = 4;
ent_seq=5;
ent_bus = 6;
// Elapsed-seconds-since-Clear, added 8 Aug 2026: TimePos (ent_time) is
// REAPER's own play_position, which only moves while the transport is
// actually rolling -- useless as a time axis for live-input testing
// (holding keys, no Play pressed). time_precise() is real wall-clock
// time regardless of transport state, so this gives every entry a
// timestamp relative to the last Clear that's always meaningful.
ent_elapsed = 7;
ent_size = 8;

// .... DarkStar (casrya NOTE: C = -1 gives middle C is C4)
FIRST_C = -1; //-2 for C-2 to G8, -1 for C-1 to G9 or 0 for C0 to G10

hextab = 0;
i=0;
loop(10,hextab[i] = $'0' + i; i+=1; );
loop(6,hextab[i] = $'a' + i - 10; i+=1; );

names = 20;
names[00] =$'C'; names[01] =$' '; names[02] =$'C'; names[03] =$'#'; names[04] =$'D'; names[05] =$' ';
names[06] =$'D'; names[07] =$'#'; names[08] =$'E'; names[09] =$' '; names[10] =$'F'; names[11] =$' ';
names[12] =$'F'; names[13] =$'#'; names[14] =$'G'; names[15] =$' '; names[16] =$'G'; names[17] =$'#';
names[18] =$'A'; names[19] =$' '; names[20] =$'A'; names[21] =$'#'; names[22] =$'B'; names[23] =$' ';

// Added by casrya for SysEx
midi_buf = 1000;
max_midi_buf_len = 1000;

// casrya: modified to sit above midi_buf
hist = midi_buf + max_midi_buf_len;
hist_size = 0;
hist_max = 10000*ent_size;
hist_chunk = 1000*ent_size; // advance

// Clear-relative time origin, added 8 Aug 2026 -- see ent_elapsed above.
// Set here too (not just on Clear) so a freshly loaded instance has a
// sane origin from the start, before the user ever clicks Clear.
clear_time_origin = time_precise();
// casrya: uncomment to test history trimming with small history
//hist_max = 10*ent_size;
//hist_chunk = ent_size; // advance

seq=0;

log_active=1;
g_cap=0;
g_capst=0;
g_at_end = 1;
g_force_redraw=1;

// Filter switches, 5 Aug 2026: hide rows at display time, not capture
// time -- history keeps everything, the switches just choose what's
// currently visible, so toggling never loses already-captured data.
filter_hide_notes = 0;
filter_hide_mpe   = 0;

// "Only print when it changes", 5 Aug 2026: last-seen value per channel
// for each of the three MPE controllers, so a captured message can be
// flagged as an exact repeat at capture time. Sentinel -1 so the very
// first message on any channel always counts as a change. Placed at a
// high address, well clear of hist's range (hist tops out well under
// 100000 given hist_max = 10000*ent_size and ent_size = 8).
mpe_last_pb   = 500000; // 16 slots, pitch bend
mpe_last_cc74 = 500020; // 16 slots
mpe_last_cp   = 500040; // 16 slots
i = 0;
loop(16,
  mpe_last_pb[i]   = -1;
  mpe_last_cc74[i] = -1;
  mpe_last_cp[i]   = -1;
  i += 1;
);

gfx_clear=-1;

load_CC_names();


// ======================================================================
@block
// ======================================================================

// casrya: common between standard MIDI and SysEx
// PRE: set specific fields BEFORE calling since this increments hist_size
function set_history_common()
(
  hist[hist_size+ent_time] = play_position;
  hist[hist_size+ent_blockoffs] = ts;
  hist[hist_size+ent_seq] = seq; seq+=1;
  hist[hist_size+ent_bus] = midi_bus;
  hist[hist_size+ent_elapsed] = time_precise() - clear_time_origin;
  hist_size+=ent_size;
  g_force_redraw=1;
);

// Added by casrya
function set_history_sysex() local (sysex_cnt, i)
(
  // we store the actual len if > 8 bytes
  sysex_cnt = hist[hist_size+ent_sysex_cnt] = midi_len;
  i=0;
  // put our bytes into the two variables for max 8 bytes
  loop(min(sysex_cnt,8),
    i < 4 ? hist[hist_size+ent_midiinfo] |= midi_buf[i] << (i * 8) :
      hist[hist_size+ent_midiinfo2] |= midi_buf[i] << ((i - 4) * 8);
    i+=1;
  );
);

log_active ?
(
  // casrya: use midirecv_buf so we can handle SysEx
  // casrya: use modern while loop for clarity
  while (midi_len = midirecv_buf(ts,midi_buf,max_midi_buf_len))
  (
    // Added by casrya: SysEx
    midi_buf[0]==$xF0 ?
    (
      // casrya: populate ent_midiinfo + ent_midiinfo2
      set_history_sysex();
      // casrya: extracted for SysEx
      set_history_common();
    )
    :
    // System Common/Real-Time skip, 6 Aug 2026: Clock/Start/Stop/
    // Continue/Active Sensing/Reset/MTC Quarter Frame/Song Position/
    // Song Select/Tune Request (0xF1-0xFF) all share status nibble
    // 0xF, so they can't be told apart by the channel-message parsing
    // below (which also assumes byte counts that don't match these --
    // several have 0 or 1 data bytes, not 3) and their low nibble
    // isn't a channel at all. Not logged for now; still passed through
    // untouched below.
    midi_buf[0] >= $xF1 ?
    (
      0; // not logged, just fall through to the pass-through send below
    )
    :
    // casrya: original code for normal non SysEx
    (
      // casrya: convert buf to msgs
      msg1 = midi_buf[0]; // must have at least 1 byte based on while condition
      msg2 = midi_len > 1 ? midi_buf[1] : 0;
      msg3 = midi_len > 2 ? midi_buf[2] : 0;

      // casrya NOTE: this discards the oldest chunk by copying the array back one chunk
      hist_size >= hist_max ?
      (
        memcpy(hist,hist+hist_chunk,hist_max-hist_chunk);
        hist_size = hist_max - hist_chunk;
      );

      // "Only print when it changes", 5 Aug 2026: flag this entry as a
      // duplicate (bit 24, safely above msg1/msg2/msg3's packed range
      // of bits 0-23) if it repeats the last value seen for this exact
      // controller + channel. is_entry_hidden() reads this flag to hide
      // repeats whenever MPE data is visible, regardless of the Hide
      // MPE switch's own state.
      mtype_cap = (msg1>>4)&15;
      mchan_cap = msg1 & 15;
      is_dup_cap = 0;
      mtype_cap == 14 ? (
        mval_cap = msg2 | (msg3<<7);
        mval_cap == mpe_last_pb[mchan_cap] ? is_dup_cap = 1;
        mpe_last_pb[mchan_cap] = mval_cap;
      ) : mtype_cap == 13 ? (
        mval_cap = msg2;
        mval_cap == mpe_last_cp[mchan_cap] ? is_dup_cap = 1;
        mpe_last_cp[mchan_cap] = mval_cap;
      ) : mtype_cap == 11 && msg2 == 74 ? (
        mval_cap = msg3;
        mval_cap == mpe_last_cc74[mchan_cap] ? is_dup_cap = 1;
        mpe_last_cc74[mchan_cap] = mval_cap;
      );

      // casrya: calc msg23 for original usage
      msg23 = msg2 + (msg3 * 256);
      hist[hist_size+ent_midiinfo] = msg1 + msg23*256 + (is_dup_cap ? 16777216 : 0);
      // casrya: not a SysEx
      hist[hist_size+ent_sysex_cnt] = 0;
      // casrya: extracted for SysEx
      set_history_common();
    );
    // casrya: pass through any MIDI including SysEx
    midisend_buf(ts,midi_buf,midi_len);
  );
);

// ======================================================================
@gfx 400 800
// casrya: scale up based on assigned gfx_ext_retina value which is 1.75 for 175% scaling
gfx_setfont(1, "Consolas", 16 * gfx_ext_retina);

// ======================================================================

// -------------------------------------------------------------
function set_colour(Ptype, Pval)
// -------------------------------------------------------------
(
      Ptype ==  9 && Pval > 0 ?  ( gfx_r=0.70; gfx_g=0.50; gfx_b = 0.20; )    //  Note On
    : Ptype ==  9 && Pval == 0 ? ( gfx_r=0.70; gfx_g=0.70; gfx_b = 0.20; )    //  Note On (Off)
    : Ptype ==  8 ?              ( gfx_r=0.70; gfx_g=0.70; gfx_b = 0.20; )    //  Note Off

    : Ptype == 10 ?              ( gfx_r=0.70; gfx_g=0.55; gfx_b = 0.20; )    //  Poly After
    : Ptype == 11 ?              ( gfx_r=0.20; gfx_g=0.60; gfx_b = 0.60; )    //  CC
    : Ptype == 12 ?              ( gfx_r=0.70; gfx_g=0.25; gfx_b = 0.20; )    //  Prog Change
    : Ptype == 13 ?              ( gfx_r=0.60; gfx_g=0.60; gfx_b = 0.80; )    //  Chan Press
    : Ptype == 14 ?              ( gfx_r=0.50; gfx_g=0.80; gfx_b = 0.50; );   //  Pitch Wheel

); // wnd of function


// -------------------------------------------------------------
function print_note_name (PnoteX)
// -------------------------------------------------------------
local ( Lname )
(
    // casrya: remove gfx_x offsets and just rely on spaces instead
    Lname = (PnoteX %12) *2;
    gfx_drawchar(names[Lname]);
    names[Lname+1] == $'#' ? gfx_drawchar($'#');
    gfx_drawnumber(floor(PnoteX/12) + FIRST_C,0);
);

// Added by casrya
function print_sysex() local (sysex_cnt, i, val)
(
  gfx_r=1.0; gfx_g=0.25; gfx_b = 0.20;
  sysex_cnt = g_pos[ent_sysex_cnt];
  gfx_printf("  SysEx %d bytes      ",sysex_cnt);
  gfx_r=0.7; gfx_g=0.7; gfx_b = 0.85;
  i=0;
  // constrain to max 8 bytes
  loop(min(8, sysex_cnt),
    i < 4 ? val = g_pos[ent_midiinfo] >> (i * 8) & $xFF
     : val = g_pos[ent_midiinfo2] >> ((i - 4) * 8) & $xFF;
    gfx_printf("%02X ", val);
    i+=1;
  );
  // if we had more bytes than we could store and print
  sysex_cnt > 8 ? gfx_printf(" ...");
);

// -------------------------------------------------------------
// Export, 7 Aug 2026: text-only twin of print_note_name() above --
// same note-name logic, but written into a string instead of drawn to
// screen, for export_log() below.
// -------------------------------------------------------------
function note_name_text(out, PnoteX)
local(Lname)
(
  Lname = (PnoteX % 12) * 2;
  names[Lname+1] == $'#' ?
    sprintf(out, "%c%c%d", names[Lname], names[Lname+1], floor(PnoteX/12) + FIRST_C)
  :
    sprintf(out, "%c%d", names[Lname], floor(PnoteX/12) + FIRST_C);
);

// -------------------------------------------------------------
// Export, 7 Aug 2026, rewritten same day after hitting JSFX's ~16KB
// per-string soft cap (confirmed against REAPER's own JSFX Strings
// reference, not assumed): strcat() silently stops growing a string
// past that size, no error -- the first version of this function built
// one big string for the WHOLE history before handing it to gmem[],
// so every export silently capped at ~16KB regardless of how much was
// actually captured. Fix: write each row into gmem[] as it's built
// (via gmem_write_str() below), using only small per-row strings that
// never approach the limit, instead of accumulating everything first.
//
// Dumps the FULL captured history -- every entry in hist[], regardless
// of the Note/MPE filter switches (those are a viewing convenience
// only; export is meant to be the complete record) -- as a
// tab-separated text block. Mirrors the @gfx draw loop's own decoding
// of the packed ent_midiinfo field, but writes to gmem instead of
// drawing.
//
// JSFX itself cannot write an arbitrary file to disk: file_open() is
// read-only, and file_var/file_mem/file_string only work inside
// @serialize, against the plugin's own state blob, not a chosen path.
// JSFX also can't call REAPER API functions like SetExtState directly --
// that's ReaScript-only. So this hands the text off via gmem[] instead,
// for the companion Log_Export.lua script (a background watcher,
// Actions list) to pick up and write out as a real .txt file.
// -------------------------------------------------------------
function gmem_write_str(pos, str)
local(n, k)
(
  n = strlen(str);
  k = 0;
  loop(n,
    gmem[pos] = str_getchar(str, k);
    pos += 1;
    k += 1;
  );
  pos;
);

function export_log()
local(ptr, endptr, msg, dnum1, dnum2, tnum1, pb_value, sysex_cnt, si, val, gpos,
      first_elapsed, duration_end)
(
  // gmem[0] = generation counter, gmem[1] = final length -- both written
  // last, once the whole export is done, so the watcher never reads a
  // partially-written buffer. Row text starts at gmem[2].
  gpos = 2;
  // Zero-basing, added 8 Aug 2026: raw ent_elapsed is relative to the
  // last Clear, but there's usually a gap between clicking Clear and the
  // first actual note (2+ seconds in real use). Subtracting the first
  // captured event's own elapsed value re-bases everything to "since the
  // first note," which is what's actually meaningful to read.
  first_elapsed = hist_size > 0 ? hist[ent_elapsed] : 0;
  // Duration line, fixed 8 Aug 2026: elapsed time from the first captured
  // note to the LAST captured note -- not to "now" (time_precise() at the
  // moment Export was clicked), which overcounts by however long you sat
  // idle after playing before clicking Export. hist[] only grows while
  // log_active is true (see @gfx's capture gate), so the last entry's own
  // ent_elapsed is already the correct stop point whether Log is still on,
  // was switched off, or Export was clicked ages later -- no separate
  // "Log OFF" bookkeeping needed.
  duration_end = hist_size > 0 ? hist[hist_size - ent_size + ent_elapsed] : first_elapsed;
  sprintf(#exp_line, "Duration: %.3f seconds\n\n", duration_end - first_elapsed);
  gpos = gmem_write_str(gpos, #exp_line);
  gpos = gmem_write_str(gpos, "Seq\tTimePos\tElapsed\tBus\tChan\tType\tIdent\tValue\n");

  ptr = hist;
  endptr = hist + hist_size;
  while (ptr < endptr) (
    tnum1 = ptr[ent_time] + ptr[ent_blockoffs]/srate;
    sprintf(#exp_line, "%d\t%.3f\t%.3f\t%d\t%d\t",
      ptr[ent_seq], tnum1, ptr[ent_elapsed] - first_elapsed, ptr[ent_bus]+1, (ptr[ent_midiinfo]&15)+1);
    gpos = gmem_write_str(gpos, #exp_line);

    ptr[ent_sysex_cnt] > 0 ? (
      sysex_cnt = ptr[ent_sysex_cnt];
      sprintf(#exp_line, "SysEx\t%d bytes: ", sysex_cnt);
      gpos = gmem_write_str(gpos, #exp_line);
      si = 0;
      loop(min(sysex_cnt, 8),
        si < 4 ? val = ptr[ent_midiinfo] >> (si * 8) & $xFF
          : val = ptr[ent_midiinfo2] >> ((si - 4) * 8) & $xFF;
        sprintf(#exp_line, "%02X ", val);
        gpos = gmem_write_str(gpos, #exp_line);
        si += 1;
      );
      gpos = gmem_write_str(gpos, "\n");
    ) : (
      msg = ptr[ent_midiinfo];
      dnum1 = (msg/16)&15;
      dnum2 = (msg>>16)&127;

      dnum1 ==  9 && dnum2 > 0 ?   gpos = gmem_write_str(gpos, "Note On\t")
      : dnum1 ==  9 && dnum2 == 0 ? gpos = gmem_write_str(gpos, "Note On (Off)\t")
      : dnum1 ==  8 ?               gpos = gmem_write_str(gpos, "Note Off\t")
      : dnum1 == 10 ?               gpos = gmem_write_str(gpos, "Poly After\t")
      : dnum1 == 11 ?               gpos = gmem_write_str(gpos, "CC\t")
      : dnum1 == 12 ?               gpos = gmem_write_str(gpos, "Prog Change\t")
      : dnum1 == 13 ?               gpos = gmem_write_str(gpos, "Chan Press\t")
      : dnum1 == 14 ?               gpos = gmem_write_str(gpos, "Pitch Wheel\t")
      : dnum1 >  14 ? (
          sprintf(#exp_line, "#%02d\t", dnum1);
          gpos = gmem_write_str(gpos, #exp_line);
        );

      msg /= 256;
      dnum2 = msg&255;

      dnum1 < 13 ? (
        dnum1 == 11 ? (
          sprintf(#exp_line, "%d ", dnum2);
          gpos = gmem_write_str(gpos, #exp_line);
          gpos = gmem_write_str(gpos, dnum2+1);
        ) : dnum1 > 10 ? (
          sprintf(#exp_line, "%d", dnum2);
          gpos = gmem_write_str(gpos, #exp_line);
        ) : (
          note_name_text(#exp_line, dnum2);
          gpos = gmem_write_str(gpos, #exp_line);
        );
      );
      gpos = gmem_write_str(gpos, "\t");

      msg /= 256;
      dnum1 != 12 ? (
        dnum1 == 14 ? (
          pb_value = dnum2 + (msg&255)*128 - (128*64);
          sprintf(#exp_line, "%d", pb_value);
        ) : dnum1 == 13 ? (
          sprintf(#exp_line, "%d", dnum2);
        ) : (
          sprintf(#exp_line, "%d", msg&255);
        );
        gpos = gmem_write_str(gpos, #exp_line);
      );
      gpos = gmem_write_str(gpos, "\n");
    );

    ptr += ent_size;
  );

  export_generation += 1;
  gmem[1] = gpos - 2;
  gmem[0] = export_generation;
);

// Filter switches, 5 Aug 2026: shared classification, used both by the
// draw loop (to skip hidden rows) and by find_auto_follow_pos() below
// (to fix the "flickers, stuck on one spot" bug -- see that function's
// comment for why it exists).
// Bug fix, 5 Aug 2026: this originally read the CC NUMBER as
// (msg>>16)&127, which is actually the low 7 bits of msg3 -- the CC
// VALUE, not msg2, the CC number. That meant "Hide MPE" was matching
// any CC message whose current VALUE happened to be 74, and missing
// real CC74 messages whenever their value wasn't 74. msg2 (the real CC
// number) sits at bits 8-15, i.e. (msg>>8)&255.
function is_entry_hidden(ptr)
local(msg, mtype, mnum, is_dup, is_mpe_type)
(
  msg = ptr[ent_midiinfo];
  mtype = (msg/16)&15;
  mnum  = (msg>>8)&255;
  is_dup = (msg>>24)&1;
  is_mpe_type = mtype == 13 || mtype == 14 || (mtype == 11 && mnum == 74);
  ptr[ent_sysex_cnt] == 0 && (
    (filter_hide_notes && (mtype == 8 || mtype == 9))
    || (filter_hide_mpe && is_mpe_type)
    // "only print when it changes", 5 Aug 2026: an MPE entry flagged as
    // an exact repeat of the previous value for its own channel (set at
    // capture time, see set_history_common() call site) is hidden
    // regardless of the Hide MPE switch's own state -- deduplication is
    // useful any time MPE data is visible at all, not just in isolation.
    || (is_dup && is_mpe_type)
  );
);

// Filter switches, 5 Aug 2026: the auto-follow "show the latest" position
// used to be plain arithmetic -- g_histsize - g_viewsize -- entirely
// unaware of filtering. With Notes hidden, notes still dominate the RAW
// entry count, so "the last g_viewsize raw entries" was almost always
// nearly all-hidden, leaving zero or one visible row in view. Because
// that raw position shifts forward by one on every single incoming note
// (hidden or not), the one visible row that did fall in range kept
// jumping and redrawing right under the header on every redraw --
// tjingboem's "flickers... printed on the same spot." Fix: walk
// backward from the newest entry counting only VISIBLE ones until
// g_viewsize are found (or history runs out), so the auto-follow window
// is sized in on-screen rows, not raw log entries. With both filters
// off this is exactly equivalent to the old arithmetic.
function find_auto_follow_pos()
local(idx, visible_count)
(
  idx = g_histsize;
  visible_count = 0;
  while (
    idx > 0 && visible_count < g_viewsize ? (
      idx -= 1;
      !is_entry_hidden(hist + idx * ent_size) ? visible_count += 1;
      1;
    ) : 0;
  );
  idx;
);

// -------------------------------------------------------------
top_margin=(gfx_texth + 4.0) * 2;
scroll_width = top_margin /2;
g_histsize = ((hist_size/ent_size)|0);
g_viewsize = (((gfx_h-top_margin-1)/(gfx_texth+2))|0);

// Filter switches, 5 Aug 2026: auto-follow now uses find_auto_follow_pos()
// (walks backward counting only VISIBLE entries) instead of plain
// g_histsize - g_viewsize arithmetic -- see that function's comment for
// why the old arithmetic caused the "flickers on the same spot" bug
// whenever a filter was hiding a large share of traffic. Manual-scroll
// (not at_end) keeps the original raw-count clamp unchanged.
g_at_end ? (
  g_pos = find_auto_follow_pos();
  g_scroll = g_pos;
) : (
  g_pos = g_histsize - g_viewsize;
  g_pos > g_scroll ? g_pos = g_scroll;
);

g_pos < 0 ? g_pos=0;

g_scrollbar_top = top_margin+1 + g_pos * (gfx_h-top_margin-1) / g_histsize;
g_scrollbar_bot = top_margin + 1+  (g_pos + g_viewsize)*(gfx_h-top_margin-1)/g_histsize;

g_cap ? (
  g_capst=0;
  g_cap == 1 ? (
    g_pos = mouse_y;
    g_scrollbar_offs >= 0 ? g_pos-= g_scrollbar_offs;
    g_pos -= top_margin+1;
    g_pos = g_histsize * g_pos / (gfx_h-top_margin-1);

    g_scroll = (g_pos |= 0);
    g_pos < 0 ? g_pos=0;

    g_pos >= g_histsize-g_viewsize ? ( g_at_end=1; g_pos = g_histsize-g_viewsize; ) : g_at_end=0;
    g_pos < 0 ? g_pos=0;

    g_scrollbar_top = top_margin+1 + g_pos * (gfx_h-top_margin-1) / g_histsize;
    g_scrollbar_bot = top_margin+1 + (g_pos + g_viewsize)*(gfx_h-top_margin-1)/g_histsize;
  ) :
  g_cap == 4 && mouse_y < top_margin && mouse_X >= g_logx && mouse_x <= g_logx_e ? (
   !(mouse_cap&1)? log_active = !log_active;
   g_capst=1;
  ) :
  g_cap == 3 && mouse_y < top_margin && mouse_X >= g_clearx && mouse_x <= g_clearx_e ? (
    !(mouse_cap&1) ? (
       seq=hist_size=0;g_histsize=0;
       clear_time_origin = time_precise();
       g_pos=1; g_at_end=1;
       g_scrollbar_top = top_margin+1 + g_pos * (gfx_h-top_margin-1) / g_histsize;
       g_scrollbar_bot = top_margin+1 + (g_pos + g_viewsize)*(gfx_h-top_margin-1)/g_histsize;    );
    g_capst=1;
  ) :
  // Filter switches, 5 Aug 2026: same toggle pattern as the Log button
  g_cap == 5 && mouse_y < top_margin && mouse_X >= g_notesx && mouse_x <= g_notesx_e ? (
    !(mouse_cap&1) ? filter_hide_notes = !filter_hide_notes;
    g_capst=1;
  ) :
  g_cap == 6 && mouse_y < top_margin && mouse_X >= g_mpex && mouse_x <= g_mpex_e ? (
    !(mouse_cap&1) ? filter_hide_mpe = !filter_hide_mpe;
    g_capst=1;
  ) :
  // Export, 7 Aug 2026: same click pattern as the other header buttons
  g_cap == 7 && mouse_y < top_margin && mouse_X >= g_exportx && mouse_x <= g_exportx_e ? (
    !(mouse_cap&1) ? export_log();
    g_capst=1;
  );

  !(mouse_cap&1) ? g_cap=0;
  g_force_redraw=1;
) : (
  (mouse_cap & 1) ? (
    g_capst=1;
    mouse_y > top_margin && mouse_x > gfx_w - top_margin ? (
      g_scrollbar_offs = -1;

      mouse_y >= g_scrollbar_top && mouse_y <= g_scrollbar_bot ? g_scrollbar_offs = mouse_y - g_scrollbar_top;

      g_cap=1; // scrollbar
    ) : (
      g_cap = 2;
      mouse_y < top_margin ? (
        mouse_x >= g_logx && mouse_x <= g_logx_e ? (
          g_force_redraw=1;
          g_cap=4;
        ) : mouse_x >= g_clearx && mouse_x <= g_clearx_e ? (
          g_force_redraw=1;
          g_cap=3;
        ) : mouse_x >= g_notesx && mouse_x <= g_notesx_e ? (
          g_force_redraw=1;
          g_cap=5;
        ) : mouse_x >= g_mpex && mouse_x <= g_mpex_e ? (
          g_force_redraw=1;
          g_cap=6;
        ) : mouse_x >= g_exportx && mouse_x <= g_exportx_e ? (
          g_force_redraw=1;
          g_cap=7;
        );
      );

    );
  ) : g_cap=0;
);

gfx_w != g_lw || gfx_h != g_lh ||  g_force_redraw ? (
  g_force_redraw=0;
  g_lw=gfx_w; g_lh=gfx_h;
  gfx_r=gfx_g=gfx_b=0; gfx_a=1;


  gfx_x=gfx_y=0;
  gfx_rectto(g_lw,g_lh);


  // draw top lines
// .... DarkStar, change banner on  Shift+click
//  gfx_r=0.30; gfx_g=0.30; gfx_b =0.70;
  mouse_y <= top_margin && mouse_cap == 9 ? (
      rtint = rand(1)/2;
      gtint = rand(1)/2;
      btint = rand(1)/2;
  );
  gfx_r = rtint;
  gfx_g = gtint;
  gfx_b = btint;

  gfx_x=gfx_y=0;
  gfx_rectto(g_lw,top_margin);

  g_cap == 4 && g_capst ? (
    gfx_r=1; gfx_g=gfx_b=0; gfx_x=0; gfx_y=0; gfx_rectto(gfx_x+3*gfx_texth,top_margin/2); // casrya: add scaling
  );
  gfx_r=gfx_g=gfx_b=log_active? 0.8 : 0.6;
  gfx_x=0;
  gfx_y=2;
  g_logx = gfx_x;
  // Label switch, 6 Aug 2026: "Log" gates MIDI pass-through as well as
  // recording (see @block), so make that state visible in the label
  // itself rather than relying on the dimmer color alone. Padded to the
  // same 7-char width as "Log OFF" so Clear/Notes/MPE don't shift right
  // of it when the label text changes.
  log_active ? gfx_printf("Log    ") : gfx_printf("Log OFF");
  g_logx_e = gfx_x;

  gfx_x += gfx_texth * 2; // casrya: add scaling

  g_cap == 3 && g_capst ? (
    g_lx=gfx_x;
    gfx_y=0; gfx_r=1; gfx_g=gfx_b=0; gfx_rectto(gfx_x+3*gfx_texth,top_margin/2); // casrya: add scaling
    gfx_x=g_lx;
    gfx_y=2;
  );

  gfx_r=0.8; gfx_g=0.8; gfx_b=0.85;
  g_clearx = gfx_x;
  // Renamed from "Clear" to "Clear&Ready", 8 Aug 2026: this button now
  // also resets the elapsed-time origin (see clear_time_origin), so the
  // label should say what it means to the user -- everything's wiped and
  // the measurement window is about to begin, even though internally the
  // clock itself starts ticking right at this click, not at the first
  // note (export_log() re-bases to the first note afterward).
  gfx_printf("Clear&Ready");
  g_clearx_e = gfx_x;

  gfx_x += gfx_texth * 2; // casrya: add scaling

  // Value position, 6 Aug 2026: moved left from 36 towards the other
  // columns -- this single constant is the only thing to tune further.
  // Computed here (before Note/MPE Filter) since the alignment below
  // needs it.
  val_pos_x = 28 * gfx_texth; // casrya: add scaling (was hardcoded 480)

  // Note/MPE Filter alignment, 6 Aug 2026: shift both buttons together
  // by the same delta (preserving their existing side-by-side spacing)
  // so MPE Filter's own "Filter" text lands at the same x as the Value
  // column header below. Real pixel widths via gfx_measurestr, not the
  // gfx_texth approximation used elsewhere, since Consolas glyph width
  // isn't equal to glyph height.
  base_x = gfx_x;
  gfx_measurestr("Note Filter", notefilter_w, tmp_h);
  gfx_measurestr("MPE ", mpe_prefix_w, tmp_h);
  natural_mpex = base_x + notefilter_w + gfx_texth * 2;
  align_delta = (val_pos_x - mpe_prefix_w) - natural_mpex;
  gfx_x += align_delta;

  // Filter switches, 5 Aug 2026: same button pattern as Log/Clear above.
  // Lit (brighter) means that message type is currently being hidden,
  // matching Log's own convention of brighter = engaged.
  g_cap == 5 && g_capst ? (
    g_lx=gfx_x;
    gfx_y=0; gfx_r=1; gfx_g=gfx_b=0; gfx_rectto(gfx_x+3*gfx_texth,top_margin/2);
    gfx_x=g_lx;
    gfx_y=2;
  );
  gfx_r=gfx_g=gfx_b=filter_hide_notes ? 0.8 : 0.5;
  g_notesx = gfx_x;
  gfx_printf("Note Filter");
  g_notesx_e = gfx_x;

  gfx_x += gfx_texth * 2;

  g_cap == 6 && g_capst ? (
    g_lx=gfx_x;
    gfx_y=0; gfx_r=1; gfx_g=gfx_b=0; gfx_rectto(gfx_x+3*gfx_texth,top_margin/2);
    gfx_x=g_lx;
    gfx_y=2;
  );
  gfx_r=gfx_g=gfx_b=filter_hide_mpe ? 0.8 : 0.5;
  g_mpex = gfx_x;
  gfx_printf("MPE Filter");
  g_mpex_e = gfx_x;

  gfx_x += gfx_texth * 2;

  // Export, 7 Aug 2026: dumps the FULL captured history (every entry,
  // ignoring the Note/MPE filters -- those are a viewing convenience,
  // export is meant to be the complete record) to gmem[] for a
  // companion ReaScript to write out as a real .txt file. See
  // export_log() below for why this hand-off is needed instead of a
  // direct file write.
  g_cap == 7 && g_capst ? (
    g_lx=gfx_x;
    gfx_y=0; gfx_r=1; gfx_g=gfx_b=0; gfx_rectto(gfx_x+3*gfx_texth,top_margin/2);
    gfx_x=g_lx;
    gfx_y=2;
  );
  gfx_r=gfx_g=gfx_b=0.5;
  g_exportx = gfx_x;
  gfx_printf("Export");
  g_exportx_e = gfx_x;

  // Button-row band, 6 Aug 2026: light green, translucent strip under
  // Log/Clear/Note Filter/MPE Filter/Export, separating them from the
  // column header below. gfx_a is restored to 1 right after so it
  // doesn't bleed into the header text or row drawing that follows.
  gfx_r=0.5; gfx_g=1.0; gfx_b=0.5; gfx_a=0.35;
  gfx_x=0; gfx_y=top_margin/2 - 3;
  gfx_rectto(g_exportx_e, top_margin/2);
  gfx_a=1;
  gfx_y=2; // casrya: restore so the header line's += below lands correctly

  gfx_x =0; gfx_y += gfx_texth + 2; // casrya: add scaling
  gfx_printf("   Seq  TimePos    Bus  Chan    Type            Ident");
  // casrya: use gfx_x to display Value header since we use gfx_x for actual value display so we need to match scaling
  // NOTE: not sure why val_pos_x was not sufficient. Maybe because font width is not scaled proportionally and there is no gfx_textw?
  gfx_x = val_pos_x;
  gfx_printf("Value");
  gfx_x = 0;

// ---------------------------------
  // right scrollbar
  gfx_r=0.0; gfx_g=gfx_b=0.3;
  gfx_x=gfx_w-scroll_width;
  gfx_y=top_margin+1;
  gfx_rectto(gfx_w,gfx_h);

  gfx_r=0.0; gfx_g=gfx_b=0.7;

  gfx_y = g_scrollbar_top;
  gfx_x=gfx_w-scroll_width+1;
  gfx_rectto(gfx_w-1,g_scrollbar_bot);

  g_pos = (g_pos|0) * ent_size + hist;
  gfx_y=top_margin+1;
  hist_size ? while (
    // casrya: moved color change inside while loop due to sysex
    gfx_r=0.7; gfx_g=0.7; gfx_b=0.85;
    gfx_x=0;
    tnum1 = g_pos[ent_time] + g_pos[ent_blockoffs]/srate;

    // Filter switches, 5 Aug 2026: peek at the message type before any
    // drawing happens, so a hidden row costs zero screen space -- the
    // next visible row just moves up to fill the gap, rather than
    // leaving a blank line. Shared classification with
    // find_auto_follow_pos() above via is_entry_hidden(), so the two
    // can't drift out of sync.
    row_hidden = is_entry_hidden(g_pos);

    !row_hidden ? (
    // casrya: use space chars instead of gfx_x for consistent spacing
    // Column-alignment fix, 5 Aug 2026: this used to also print
    // g_pos[ent_blockoffs] as a raw "%4d" here, with no matching header
    // label -- it's already folded into tnum1 above for the TimePos
    // value, so printing it again just pushed every column after it
    // (Bus/Chan/Type/Ident) several characters right of where the
    // header says they should be. Removed the orphaned field; verified
    // against the actual header string character-by-character that Bus
    // now lands at column 19, Chan at 24, Type at 32 -- exactly matching
    // "   Seq  TimePos    Bus  Chan    Type            Ident" above.
    // Seq/TimePos dimming, 6 Aug 2026: same grey as the "Log OFF" label,
    // restored right after so Bus/Chan keep their original color.
    gfx_r=0.6; gfx_g=0.6; gfx_b=0.6;
    gfx_printf(" %5d %8.3f    ", g_pos[ent_seq], tnum1);
    gfx_r=0.7; gfx_g=0.7; gfx_b=0.85;

// .... message bus and channel
    gfx_printf("%2d", g_pos[ent_bus]+1);
    g_msg = g_pos[ent_midiinfo];
    gfx_printf("   %2d    ", (g_msg&15) +1);

    // casrya: Added SysEx (Max 8 bytes displayed)
    g_pos[ent_sysex_cnt] > 0 ?
    (
      print_sysex();
    )
    :
    // NOT SysEx
    (
      // .... message type and colour
      gfx_b = 0.20;
      dnum1 = (g_msg/16)&15;
      dnum2 = (g_msg>>16)&127;
      set_colour(dnum1, dnum2);

      // casrya: add more trailing spaces to balance spacing with long CC names
      dnum1   ==  9 && dnum2 > 0 ?  gfx_printf("  Note On            ")
      : dnum1 ==  9 && dnum2 == 0 ? gfx_printf("  Note On (Off)      ")
      : dnum1 ==  8 ?               gfx_printf("  Note Off           ")
      : dnum1 == 10 ?               gfx_printf("  Poly After         ")
     // : dnum1 == 11 ?               gfx_printf("  CC ") // casrya: added trailing space and removed gfx_x offset below
      : dnum1 == 12 ?               gfx_printf("  Prog Change        ")
      : dnum1 == 13 ?               gfx_printf("  Chan Press         ")
      : dnum1 == 14 ?               gfx_printf("  Pitch Wheel        ")
      : dnum1 >  14 ?               gfx_printf("    #%02d          ", dnum1);

      g_msg/=256;
      dnum2 = g_msg&255;

  // .. note name or CC name
      dnum1 < 13 ?
          dnum1 == 11 ? (gfx_printf("%2d ", dnum2); gfx_drawstr(dnum2+1))
          : dnum1 >  10 ?  gfx_printf(" %3d", dnum2)
  // note names
          :               print_note_name (dnum2);
  // note numbers        :                 gfx_printf(" %3d", dnum2);

  // .. data values
      gfx_r=0.7; gfx_g=0.7; gfx_b = 0.85;
      g_msg/=256;
      dnum1 != 12 ?
      dnum1 == 14 ? (
  //      pb_value = msg_num[Prd_idx] + msg_val[Prd_idx] * 128 - (128 * 64);
          pb_value = dnum2 + (g_msg&255) * 128 - (128 * 64);
          gfx_x = (val_pos_x-gfx_texth); // casrya: add scaling
          pb_value > 0 ? gfx_printf("+%4d", pb_value)
                       : gfx_printf("%5d",  pb_value);
      ):
      // Chan Press value fix, 6 Aug 2026: Channel Pressure is a 2-byte
      // message (status + 1 data byte), so its value lives in msg2
      // (still held in dnum2 from the note/CC-name section above) --
      // msg3 was never set and stays 0, which is what g_msg&255 below
      // reads for every other type.
      dnum1 == 13 ? (
          gfx_x = val_pos_x; // casrya: add scaling
          gfx_printf("%3d", dnum2);
      ):(
          gfx_x = val_pos_x; // casrya: add scaling
          gfx_printf("%3d", g_msg&255);
    );
    ); // casrya: end non-sysex block

    gfx_y += gfx_texth+2;
    ); // casrya: end !row_hidden block (filter switches, 5 Aug 2026)

    g_pos += ent_size;
    gfx_y < gfx_h && g_pos < hist + hist_size;
  );

  g_at_end ? (
    gfx_x=0;
    gfx_drawchar($'_');
  );

);
