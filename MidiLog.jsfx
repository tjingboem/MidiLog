desc:MIDI Log
// version 04 (v02 DS)
//tags: MIDI analysis utility
// .... pimped by DarkStar, July 2018
// https://forums.cockos.com/showthread.php?t=189126&highlight=midi+logger
//
// casrya: 6/05/2025 added HiDpi scaling and SysEx display (max 8 bytes hex)

in_pin:none
out_pin:none

// Export, 7 Aug 2026: named gmem segment so Log_Export.lua can attach to
// the same buffer via reaper.gmem_attach("MidiLogExport") -- JSFX
// has no direct call into REAPER's own API (SetExtState etc. are not
// reachable from plain JSFX), so gmem is the actual bridge.
options:gmem=MidiLogExport

// ======================================================================
@init
// added by casrya for HiDpi
gfx_ext_retina == 0 ? gfx_ext_retina = 1;

// ======================================================================

// -------------------------------------------------------------
function load_CC_names()
// -------------------------------------------------------------
(
    strcpy(1,"Bank Select MSB");
    strcpy(2,"Mod Wheel MSB");
    strcpy(3,"Breath control MSB");
